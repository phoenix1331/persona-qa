{
  "name": "personaqa",
  "version": "0.1.0",
  "description": "QA agents that use your app like real people: persona-driven browser runs that produce journals, evidence-backed issues and Playwright regression tests.",
  "author": {
    "name": "phoenix1331",
    "url": "https://github.com/phoenix1331"
  },
  "homepage": "https://github.com/phoenix1331/persona-qa",
  "repository": "https://github.com/phoenix1331/persona-qa",
  "license": "MIT",
  "keywords": [
    "qa",
    "ux-testing",
    "accessibility",
    "playwright",
    "personas",
    "e2e-testing"
  ],
  "mcpServers": {
    "browser": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/dist/index.mjs"
      ],
      "env": {
        "PERSONAQA_PLUGIN_ROOT": "${CLAUDE_PLUGIN_ROOT}",
        "PERSONAQA_DATA": "${CLAUDE_PLUGIN_DATA}",
        "PERSONAQA_PROJECT_DIR": "${CLAUDE_PROJECT_DIR}",
        "PLAYWRIGHT_BROWSERS_PATH": "${CLAUDE_PLUGIN_DATA}/browsers"
      }
    }
  }
}
