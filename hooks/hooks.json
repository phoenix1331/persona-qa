{
  "description": "PersonaQA: install the browser on first run, log browser tool calls, keep persona runners black box and make sure they finish.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 30,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/setup.mjs"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|Read|Write|Edit|MultiEdit|NotebookEdit|Glob|Grep|WebFetch|WebSearch|Agent|mcp__(?!plugin_personaqa_browser__).*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/guard-runner.mjs"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__plugin_personaqa_browser__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/log-tool.mjs"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "persona-runner$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 10,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks/require-finish.mjs"
            ]
          }
        ]
      }
    ]
  }
}
