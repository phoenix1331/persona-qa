{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phoenix1331/persona-qa/schema/config.schema.json",
  "title": "PersonaQA config",
  "description": "The .personaqa/config.yaml file in an app repository.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "app"
  ],
  "properties": {
    "version": {
      "const": 1,
      "description": "Config format version."
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "base_url",
        "allowed_domains"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "base_url": {
          "type": "string",
          "pattern": "^https?://[^\\s/]+(/.*)?$",
          "description": "Staging or local URL that mission start_url paths are resolved against."
        },
        "allowed_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Host names (optionally with :port) the browser may load. Everything else is refused.",
          "items": {
            "type": "string",
            "pattern": "^(\\*\\.)?[A-Za-z0-9.-]+(:\\d+)?$"
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "enum": [
            "none",
            "storage_state",
            "login_mission"
          ],
          "default": "none"
        },
        "storage_state": {
          "type": "string",
          "description": "Path to a Playwright storage state JSON file (a saved login), relative to the repository. Create it with /personaqa:auth."
        },
        "login_mission": {
          "type": "string",
          "description": "Mission id that signs in. Personas do it first, then continue with their real mission."
        },
        "accounts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "email",
              "password"
            ],
            "properties": {
              "email": {
                "type": "string"
              },
              "password": {
                "type": "string"
              },
              "storage_state": {
                "type": "string",
                "description": "Saved login (Playwright storage state) for this account. Defaults to auth.storage_state, or .personaqa/auth/<account>.json when created by /personaqa:auth."
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "storage_state"
              }
            },
            "required": [
              "strategy"
            ]
          },
          "then": {
            "required": [
              "storage_state"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "login_mission"
              }
            },
            "required": [
              "strategy"
            ]
          },
          "then": {
            "required": [
              "login_mission"
            ]
          }
        }
      ]
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3
        },
        "max_steps_per_run": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 60
        },
        "max_minutes_per_run": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60,
          "default": 8
        },
        "model": {
          "type": "string",
          "description": "Model for persona runners, e.g. sonnet or haiku."
        }
      }
    },
    "personas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "$ref": "#/$defs/selection"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".personaqa/personas"
          ]
        }
      }
    },
    "missions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".personaqa/missions"
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dir": {
          "type": "string",
          "default": ".personaqa/runs"
        },
        "screenshots": {
          "enum": [
            "every_action",
            "on_issue",
            "off"
          ],
          "default": "on_issue"
        },
        "trace": {
          "enum": [
            "always",
            "on_failure",
            "off"
          ],
          "default": "on_failure"
        },
        "regression_tests": {
          "enum": [
            "off",
            "suggest",
            "write"
          ],
          "default": "suggest"
        }
      }
    },
    "issues": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sink": {
          "enum": [
            "file",
            "github"
          ],
          "default": "file"
        },
        "github": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "labels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "min_severity": {
              "$ref": "#/$defs/severity"
            }
          }
        }
      }
    },
    "ci": {
      "type": "object",
      "description": "Named run sets, e.g. pull_request and nightly, used with --set.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "personas",
          "missions"
        ],
        "properties": {
          "personas": {
            "$ref": "#/$defs/selection"
          },
          "missions": {
            "$ref": "#/$defs/selection"
          }
        }
      }
    },
    "inspectors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "a11y": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "standard": {
              "enum": [
                "wcag21",
                "wcag22"
              ],
              "default": "wcag22"
            },
            "level": {
              "enum": [
                "A",
                "AA",
                "AAA"
              ],
              "default": "AA"
            },
            "mode": {
              "enum": [
                "ride_along",
                "sweep",
                "both"
              ],
              "default": "ride_along"
            },
            "ignore": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "ux": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "heuristics": {
              "enum": [
                "nielsen"
              ],
              "default": "nielsen"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "selection": {
      "oneOf": [
        {
          "const": "all"
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      ]
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    }
  }
}
