{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phoenix1331/persona-qa/schema/mission.schema.json",
  "title": "PersonaQA mission",
  "description": "A plain-English goal plus deterministic success rules checked by the browser server, never by the model.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "goal", "start_url", "success"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "goal": { "type": "string", "minLength": 1 },
    "start_url": {
      "type": "string",
      "pattern": "^(/|https?://)",
      "description": "Path resolved against app.base_url, or a full URL on an allowed domain."
    },
    "time_limit_minutes": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
    "max_steps": { "type": "integer", "minimum": 1, "maximum": 500 },
    "account": { "type": "string", "description": "Key in config auth.accounts to sign in as." },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "any": { "$ref": "#/$defs/rules" },
        "all": { "$ref": "#/$defs/rules" }
      }
    },
    "data": {
      "type": "object",
      "description": "Values the persona can use, such as test card details.",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "context": { "type": "string" }
  },
  "$defs": {
    "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } },
    "rule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["url_contains"],
          "properties": { "url_contains": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["url_matches"],
          "properties": { "url_matches": { "type": "string", "minLength": 1, "description": "JavaScript regular expression." } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text_visible"],
          "properties": { "text_visible": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["element_visible"],
          "properties": { "element_visible": { "type": "string", "minLength": 1, "description": "CSS selector." } }
        }
      ]
    }
  }
}
