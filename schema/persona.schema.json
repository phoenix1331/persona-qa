{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phoenix1331/persona-qa/schema/persona.schema.json",
  "title": "PersonaQA persona",
  "description": "A persona file. Environment is enforced by the browser server; traits are played by the model. Traits describe behaviour, never stereotypes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "extends": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Id of a persona to inherit from; only differing fields are needed." },
    "name": { "type": "string", "minLength": 1 },
    "age": { "type": "integer", "minimum": 13, "maximum": 110 },
    "bio": { "type": "string", "minLength": 1 },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "enum": ["mobile-3g", "mobile-4g", "ipad-large-text", "desktop-keyboard-only", "desktop-reduced-motion", "desktop-fast"]
        },
        "device": { "type": "string", "description": "Playwright device descriptor name, e.g. iPhone 15 or Pixel 7." },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 240, "maximum": 3840 },
            "height": { "type": "integer", "minimum": 240, "maximum": 2160 }
          }
        },
        "input": { "enum": ["touch", "mouse", "keyboard_only"] },
        "network": { "enum": ["slow-3g", "fast-3g", "4g", "wifi", "none"] },
        "text_zoom": { "type": "number", "minimum": 1, "maximum": 3 },
        "reduced_motion": { "type": "boolean" },
        "forced_colours": { "type": "boolean" },
        "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" },
        "timezone": { "type": "string", "pattern": "^[A-Za-z]+(/[A-Za-z_+-]+)+$|^UTC$" },
        "events": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "offline": {
              "type": "object",
              "additionalProperties": false,
              "required": ["chance", "duration_seconds"],
              "properties": {
                "chance": { "$ref": "#/$defs/chance" },
                "duration_seconds": { "$ref": "#/$defs/range" }
              }
            },
            "session_expiry": {
              "type": "object",
              "additionalProperties": false,
              "required": ["chance"],
              "properties": {
                "chance": { "$ref": "#/$defs/chance" },
                "after_steps": { "$ref": "#/$defs/range" }
              }
            }
          }
        }
      }
    },
    "traits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "patience_seconds": { "type": "number", "minimum": 1, "maximum": 120 },
        "reading": { "enum": ["skims", "reads", "scrutinises"] },
        "tech_confidence": { "$ref": "#/$defs/level" },
        "typo_rate": { "enum": ["none", "low", "medium", "high"] },
        "trust_in_payments": { "$ref": "#/$defs/level" },
        "back_button": { "enum": ["never", "sometimes", "often"] },
        "language_confidence": { "$ref": "#/$defs/level" }
      }
    },
    "voice": { "type": "string" }
  },
  "if": { "not": { "required": ["extends"] } },
  "then": {
    "required": ["name", "bio", "environment", "traits"],
    "properties": {
      "environment": { "type": "object", "required": ["preset"] },
      "traits": { "type": "object", "required": ["patience_seconds", "reading", "tech_confidence"] }
    }
  },
  "$defs": {
    "chance": { "type": "number", "minimum": 0, "maximum": 1 },
    "range": {
      "type": "array",
      "prefixItems": [{ "type": "number", "minimum": 0 }, { "type": "number", "minimum": 0 }],
      "minItems": 2,
      "maxItems": 2,
      "items": false
    },
    "level": { "enum": ["low", "medium", "high"] }
  }
}
